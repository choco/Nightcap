{
	"name": "nightcap-site",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr src/render.tsx --outDir ../build/site-render --emptyOutDir && node prerender.ts",
		"typecheck": "tsc -b",
		"check": "biome check",
		"format": "biome check --write"
	},
	"dependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"marked": "18.1.0",
		"playwright-core": "1.64.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	}
}
