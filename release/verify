#!/usr/bin/env bash
# The release gate: fails unless the app satisfies the committed signing requirement,
# its designated requirement matches it exactly, it carries a notarization ticket that
# Gatekeeper accepts (ADR-0017), and its executables link only system libraries and the
# embedded Sparkle (ADR-0015). Usage: release/verify <Nightcap.app>
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
app="$1"
expected="$(cat "$root/release/signing-requirement.txt")"

/usr/bin/codesign --verify --strict --deep --test-requirement="=$expected" "$app"

actual="$(/usr/bin/codesign --display --requirements - "$app" 2>&1 | sed -n 's/^designated => //p')"
if [[ "$actual" != "$expected" ]]; then
  echo "error: designated requirement is '$actual', expected '$expected'" >&2
  exit 1
fi

xcrun stapler validate -q "$app"
if ! assessment="$(/usr/sbin/spctl --assess --type execute -vv "$app" 2>&1)" \
  || ! grep -qx 'source=Notarized Developer ID' <<<"$assessment"; then
  echo "error: Gatekeeper doesn't accept the app as notarized:" >&2
  echo "$assessment" >&2
  exit 1
fi

# Without its public key, a release could never accept an update.
bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")"
public_key="$(/usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' "$app/Contents/Info.plist" 2>/dev/null || true)"
if [[ "$bundle_id" != *.dev && -z "$public_key" ]]; then
  echo "error: Info.plist has no SUPublicEDKey; run the update signing setup first" >&2
  exit 1
fi

for binary in "$app/Contents/MacOS/Nightcap" "$app/Contents/Helpers/nightcap" \
  "$app/Contents/Helpers/Tour Sample.app/Contents/MacOS/Tour Sample"; do
  foreign="$(otool -L "$binary" | tail -n +2 | awk '{print $1}' | grep -vE '^(/usr/lib/|/System/|@rpath/Sparkle\.framework/)' || true)"
  if [[ -n "$foreign" ]]; then
    echo "error: $binary links non-system libraries:" >&2
    echo "$foreign" >&2
    exit 1
  fi
done
