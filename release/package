#!/usr/bin/env bash
# Zips a signed Nightcap.app for publishing, with SHA256SUMS beside it, preserving
# symlinks and dropping extended attributes. Usage: release/package <Nightcap.app> <out-dir>
set -euo pipefail

app="$1"
out="$2"
version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")"
zip="Nightcap-$version.zip"

mkdir -p "$out"
/usr/bin/ditto -c -k --keepParent --norsrc --noextattr "$app" "$out/$zip"
(cd "$out" && shasum -a 256 "$zip" > SHA256SUMS)
