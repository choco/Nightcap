#!/usr/bin/env bash
# Signs Nightcap.app inside-out with hardened runtime, using the certificate named by the
# committed signing requirement. Dev builds also get the dev entitlements.
# Usage: release/sign <Nightcap.app> [--keychain <path>]
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
app="${1:-}"
keychain=
if [[ $# -eq 3 && "$2" == "--keychain" ]]; then
  keychain="$3"
elif [[ $# -ne 1 ]]; then
  echo "usage: release/sign <Nightcap.app> [--keychain <path>]" >&2
  exit 1
fi

requirement="$root/release/signing-requirement.txt"
if [[ ! -f "$requirement" ]]; then
  echo "error: $requirement is missing; create the signing certificate first" >&2
  exit 1
fi
identity="$(sed -n 's/.*certificate leaf = H"\([0-9a-fA-F]*\)".*/\1/p' "$requirement")"

sign() {
  /usr/bin/codesign --force --options runtime --timestamp=none \
    --sign "$identity" ${keychain:+--keychain "$keychain"} "$@"
}

bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")"
sign "$app/Contents/Helpers/nightcap"
if [[ "$bundle_id" == *.dev ]]; then
  sign --entitlements "$root/release/dev.entitlements" "$app"
else
  sign "$app"
fi
