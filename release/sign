#!/usr/bin/env bash
# Signs Nightcap.app inside-out with hardened runtime, using the Developer ID Application
# certificate of the team the committed signing requirement names. Releases get a secure
# timestamp, which notarization requires; dev builds get their own entitlements.
# Usage: release/sign <Nightcap.app> [--keychain <path>]
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
app="${1:-}"
keychain=
if [[ $# -eq 3 && "$2" == "--keychain" ]]; then
  keychain="$3"
elif [[ $# -ne 1 ]]; then
  echo "usage: release/sign <Nightcap.app> [--keychain <path>]" >&2
  exit 1
fi

requirement="$root/release/signing-requirement.txt"
team="$(sed -n 's/.*certificate leaf\[subject\.OU\] = "\{0,1\}\([A-Z0-9]*\)"\{0,1\}$/\1/p' "$requirement")"
if [[ -z "$team" ]]; then
  echo "error: $requirement names no team" >&2
  exit 1
fi
identities="$(security find-identity -v -p codesigning ${keychain:+"$keychain"} \
  | grep -F "\"Developer ID Application: " | grep -F "($team)\"" | awk '{print $2}' || true)"
if [[ -z "$identities" || "$identities" == *$'\n'* ]]; then
  echo "error: expected one valid Developer ID Application identity for team $team, found:" >&2
  echo "${identities:-none}" >&2
  exit 1
fi

bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")"
timestamp=--timestamp
entitlements=()
if [[ "$bundle_id" == *.dev ]]; then
  timestamp=--timestamp=none
  entitlements=(--entitlements "$root/release/dev.entitlements")
fi

sign() {
  /usr/bin/codesign --force --options runtime "$timestamp" \
    --sign "$identities" ${keychain:+--keychain "$keychain"} "$@"
}

# Sparkle's helpers in the order its docs give, keeping their own entitlements. --deep would
# give them the app's instead.
sparkle="$app/Contents/Frameworks/Sparkle.framework"
for helper in XPCServices/Installer.xpc XPCServices/Downloader.xpc Autoupdate Updater.app; do
  sign --preserve-metadata=entitlements "$sparkle/Versions/B/$helper"
done
sign "$sparkle"
sign "$app/Contents/Helpers/nightcap"
sign "$app/Contents/Helpers/Tour Sample.app"
sign ${entitlements[@]+"${entitlements[@]}"} "$app"
