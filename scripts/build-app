#!/usr/bin/env bash
# Builds the app with xcodebuild into build/xcode/<Debug|Release>/, unsigned.
# Debug is the dev build; pass --release for a release build. Run build-core first,
# with the same flag.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

configuration=Debug
if [[ "${1:-}" == "--release" ]]; then
  configuration=Release
fi

# The packages go to a fixed folder, where release/appcast finds Sparkle's sign_update.
scripts/xcodebuild-clean-env build \
  -project app/Nightcap.xcodeproj \
  -target Nightcap \
  -configuration "$configuration" \
  -clonedSourcePackagesDirPath "$root/build/SourcePackages" \
  SYMROOT="$root/build/xcode" \
  MARKETING_VERSION="$(scripts/version)" \
  CURRENT_PROJECT_VERSION="$(git rev-list --count HEAD)"
