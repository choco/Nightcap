#!/usr/bin/env bash
# Builds the project site into build/site: the React page in site/, prerendered to static HTML,
# with the design system's tokens and fonts and the app icon (site/plugins/design.ts). The Pages
# workflow deploys the result; preview it with `python3 -m http.server -d build/site`, or work on
# it with `pnpm --dir site dev`.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root/site"

pnpm install --frozen-lockfile
pnpm typecheck
pnpm build
