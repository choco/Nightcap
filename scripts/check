#!/usr/bin/env bash
# Runs what CI checks: every area by default, or only those named. CI's jobs call it by area.
#   --rust     rustfmt, clippy, rustdoc and the tests
#   --deps     cargo-deny's licences, bans and sources (deny.toml)
#   --audit    known vulnerabilities, as the advisory databases stand today: in the crates
#              (cargo-deny's advisories), the site's packages (pnpm audit), the Swift packages
#              (OSV-Scanner) and the workflows' actions (zizmor, with a GitHub token: GH_TOKEN,
#              else gh's login)
#   --secrets  betterleaks over every commit, with what it finds redacted
#   --scripts  shellcheck on the shell scripts in scripts/, release/ and .githooks/, and
#              actionlint on the workflows, with shellcheck on their run steps
#   --site     Biome, the type checker and the site's build (build-site)
#   --swift    swift-format against .swift-format, the debug core and the dev build
#              (build-core, build-app), the String Catalog against the dev build's strings
#              (sync-strings --check), then the Swift tests (test-app); by default only on
#              macOS, which has them
# Usage: check [--rust] [--deps] [--audit] [--secrets] [--scripts] [--site] [--swift]
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

rust=
deps=
audit=
secrets=
scripts=
site=
swift=
if [[ $# -eq 0 ]]; then
  rust=1
  deps=1
  audit=1
  secrets=1
  scripts=1
  site=1
  if [[ "$(uname)" == Darwin ]]; then
    swift=1
  fi
fi
for area in "$@"; do
  case "$area" in
    --rust) rust=1 ;;
    --deps) deps=1 ;;
    --audit) audit=1 ;;
    --secrets) secrets=1 ;;
    --scripts) scripts=1 ;;
    --site) site=1 ;;
    --swift) swift=1 ;;
    *)
      echo "usage: check [--rust] [--deps] [--audit] [--secrets] [--scripts] [--site] [--swift]" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$rust" ]]; then
  cargo fmt --all --check
  cargo clippy --workspace --all-targets -- -D warnings
  RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps
  scripts/run-tests
fi

if [[ -n "$deps" ]]; then
  cargo deny check bans licenses sources
fi

if [[ -n "$audit" ]]; then
  cargo deny check advisories
  # The site's lockfile holds two YAML documents, pnpm itself in the first. OSV-Scanner reads only
  # that one, and passes; pnpm's own audit reads both.
  pnpm --dir site audit
  osv-scanner scan source \
    --lockfile app/Nightcap.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
  # zizmor looks the actions' advisories up through GitHub's API, and without a token skips that
  # audit with only a warning.
  if [[ -z "${GH_TOKEN:-}" ]]; then
    GH_TOKEN="$(gh auth token)"
    export GH_TOKEN
  fi
  vulnerable_actions="$(zizmor --no-progress --no-exit-codes --format json-v1 . | jq -r '
    .[] | select(.ident == "known-vulnerable-actions") | .locations[]
    | select(.symbolic.kind == "Primary")
    | "\(.symbolic.key.Local.verbatim_path): \(.concrete.feature) (\(.symbolic.annotation))"')"
  if [[ -n "$vulnerable_actions" ]]; then
    echo "error: actions with known vulnerabilities:" >&2
    echo "$vulnerable_actions" >&2
    exit 1
  fi
fi

if [[ -n "$secrets" ]]; then
  # The repository and CI's logs are public, so a finding prints without the secret.
  betterleaks git --no-banner --redact --verbose .
fi

if [[ -n "$scripts" ]]; then
  # The scripts have no extensions, so their shebangs pick them out. The C locale lets awk read
  # past the images beside them.
  shell_scripts=()
  while IFS= read -r script; do
    shell_scripts+=("$script")
  done < <(LC_ALL=C find scripts release .githooks -type f -exec awk \
    'FNR == 1 && /^#!.*[^a-z](ba)?sh( |$)/ { print FILENAME } { nextfile }' {} +)
  shellcheck "${shell_scripts[@]}"
  actionlint
fi

if [[ -n "$site" ]]; then
  scripts/build-site
fi

if [[ -n "$swift" ]]; then
  xcrun swift-format lint --strict --recursive app/Nightcap app/NightcapTests app/TourSample \
    app/NightcapCore/Package.swift
  scripts/build-core
  scripts/build-app
  scripts/sync-strings --check
  scripts/test-app
fi
